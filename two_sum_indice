
def two_sum_indices(nums, target):
    """
    indices of two numbers in list that add up to target

    Args:
        nums (list): list of integers
        target (int): target sum

    Returns:
        list: list with indices [index1, index2] of two numbers.
              Returns None if no such pair
    """
    # Key: number, Value: index
    num_map = {}

    for index, num in enumerate(nums):
        # needed to reach target
        complement = target - num

        # Check if complement already in map
        if complement in num_map:
            # found. Return index of complement and index of current number
            return [num_map[complement], index]
        
        # If complement not found, add current number and index to map for future lookups
        num_map[num] = index

    # loop finishes without finding a pair
    return None

nums1 = [2, 7, 11, 15]
target1 = 9
print(f"Indices for {nums1} and target {target1}: {two_sum_indices(nums1, target1)}")
# Output: Indices for [2, 7, 11, 15] and target 9: [0, 1]

nums2 = [3, 2, 4]
target2 = 6
print(f"Indices for {nums2} and target {target2}: {two_sum_indices(nums2, target2)}")
# Output: Indices for [3, 2, 4] and target 6: [1, 2]